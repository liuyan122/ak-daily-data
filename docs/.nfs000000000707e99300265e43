<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>热榜资讯聚合</title>
<style>
  body { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; margin: 0; background: #f5f6f7; color: #222; }
  header { background: #1a1a2e; color: #fff; padding: 18px 20px; }
  header h1 { margin: 0 0 4px; font-size: 22px; }
  header .meta { font-size: 13px; color: #9fa3b3; }
  main { max-width: 1100px; margin: 16px auto; padding: 0 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; }
  .card { background: #fff; border-radius: 10px; padding: 14px 16px; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
  .card h2 { margin: 0 0 10px; font-size: 17px; border-left: 4px solid #4361ee; padding-left: 8px; }
  .card.err h2 { border-color: #e5484d; }
  .card.err::after { content: "该来源本轮抓取失败"; font-size: 12px; color: #e5484d; }
  ol { margin: 0; padding-left: 22px; font-size: 14px; line-height: 1.9; }
  li a { color: #333; text-decoration: none; }
  li a:hover { color: #4361ee; }
  .hot { color: #e5484d; font-size: 12px; margin-left: 6px; }
  .tabs { margin: 12px 0; font-size: 13px; color: #555; }
  .tabs select { padding: 4px 8px; }
  .rank-1::marker, .rank-2::marker, .rank-3::marker { color: #e5484d; font-weight: 700; }
</style>
</head>
<body>
<header>
  <h1>热榜资讯聚合</h1>
  <div class="meta">数据每小时自动更新 · 更新时间 <span id="ts">加载中…</span></div>
</header>
<main>
  <div class="tabs">
    历史快照：<select id="histSel"><option>—</option></select>
  </div>
  <div class="grid" id="grid"></div>
</main>
<script>
const BASE = location.pathname.replace(/[^/]*$/, '');
async function load(file) {
  const grid = document.getElementById('grid');
  grid.innerHTML = '';
  try {
    const r = await fetch(BASE + file + '?t=' + Date.now());
    const d = await r.json();
    document.getElementById('ts').textContent = d.updated_at || '';
    for (const s of d.sources) {
      const card = document.createElement('div');
      card.className = 'card' + (s.ok ? '' : ' err');
      const h2 = document.createElement('h2'); h2.textContent = s.name; card.appendChild(h2);
      const ol = document.createElement('ol');
      (s.items || []).forEach((it, i) => {
        const li = document.createElement('li');
        if (i < 3) li.className = 'rank-' + (i + 1);
        const a = document.createElement('a');
        a.textContent = it.title || '';
        if (it.url && /^https?:/.test(it.url)) { a.href = it.url; a.target = '_blank'; a.rel = 'noopener'; }
        else { a.href = 'javascript:void(0)'; a.style.color = '#333'; }
        li.appendChild(a);
        if (it.hot !== undefined && it.hot !== null && it.hot !== '') {
          const sp = document.createElement('span');
          sp.className = 'hot'; sp.textContent = it.hot;
          li.appendChild(sp);
        }
        ol.appendChild(li);
      });
      card.appendChild(ol);
      grid.appendChild(card);
    }
  } catch (e) {
    grid.innerHTML = '<p style="color:#e5484d">快照加载失败：' + e + '</p>';
  }
}
(async () => {
  const sel = document.getElementById('histSel');
  try {
    const r = await fetch(BASE + 'data/manifest.json?t=' + Date.now());
    const m = await r.json();
    (m.snapshots || []).slice().reverse().forEach(s => {
      const o = document.createElement('option');
      o.value = 'data/' + s + '.json';
      o.textContent = s;
      sel.appendChild(o);
    });
  } catch (e) {}
  sel.addEventListener('change', () => sel.value && load(sel.value));
  load('latest.json');
})();
</script>
</body>
</html>
